rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload and access their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow access to customer images (profile photos, measurements, etc.)
    match /customers/{customerId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == customerId;
    }
    
    // Allow access to tailor images (portfolio, work samples)
    match /tailors/{tailorId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == tailorId;
    }
    
    // Allow access to order-related images (design sketches, progress photos)
    match /orders/{orderId}/{allPaths=**} {
      allow read, write: if request.auth != null;
      // Note: You might want to restrict this further based on order ownership
    }
    
    // Public assets (fabric images, pattern thumbnails, etc.)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
      // Consider restricting write access to admin users only
    }
    
    // AI-generated content (virtual fitting images, style suggestions)
    match /ai-generated/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
