rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own customer profile
    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read and write their own orders
    match /orders/{orderId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.customerId || 
         request.auth.uid == request.resource.data.customerId);
    }
    
    // Allow users to read and write their own garments
    match /garments/{garmentId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.customerId || 
         request.auth.uid == request.resource.data.customerId);
    }
    
    // Allow users to read and write their own AI suggestions
    match /ai_suggestions/{suggestionId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.customerId || 
         request.auth.uid == request.resource.data.customerId);
    }
    
    // Allow users to read and write their own measurements
    match /measurements/{measurementId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.customerId || 
         request.auth.uid == request.resource.data.customerId);
    }
    
    // Allow authenticated users to read public data (fabric library, patterns, etc.)
    match /fabrics/{fabricId} {
      allow read: if request.auth != null;
    }
    
    match /patterns/{patternId} {
      allow read: if request.auth != null;
    }
    
    // Allow authenticated users to read tailor profiles for selection
    match /tailors/{tailorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == tailorId;
    }
    
    // Admin-only access for admin documents
    match /admin/{adminId} {
      allow read, write: if request.auth != null && request.auth.uid == adminId;
    }
    
    // Allow authenticated users to create and manage their own chat messages
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid in resource.data.participants || 
         request.auth.uid in request.resource.data.participants);
    }
    
    // Allow users to read and write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == request.resource.data.userId);
    }
    
    // Temporarily allow unauthenticated reads for testing phone lookup
    // TODO: Restrict this further for production security
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
//
/
